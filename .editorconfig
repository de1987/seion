root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# Compose convention: @Composable functions are PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_code_style = android_studio

[*.{xml,json,toml,yml,yaml}]
indent_size = 4

[*.py]
max_line_length = 120
